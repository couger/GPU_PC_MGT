# Publish source through an explicit allowlist. Runtime data stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/*.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.md
!/.github/ISSUE_TEMPLATE/*.yml
!/config.example.json
!/build.cmd
!/start-exe.cmd
!/start-dashboard.cmd
!/src/
/src/*
!/src/*.cs
!/src/*.ps1
!/tools/
/tools/*
!/tools/*.cs
!/tools/*.ps1
!/tools/*.mjs
!/tools/*.py
!/assets/
/assets/*
!/assets/*.ico
!/assets/*.png
!/web/
/web/*
!/web/index.html

# Never track generated executables, credentials or local configuration.
*.exe
*.dll
*.pdb
*.log
*.bak
*.tmp
*.pem
*.key
*.pfx
*.p12
config.json
widget.json
probe-config.json
probe-tray.json
known_hosts*
.tmp/
data/
ssh/
web/data.json
